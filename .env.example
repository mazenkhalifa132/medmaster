# Copy these values to your hosting provider's environment-variable settings.
# Do not commit a real .env file or database password.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-app.example.com
CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DATABASE_URL=postgresql://database_user:database_password@database_host:5432/database_name
# Optional: this grants admin rights to an account that already exists.
# Leave empty on the first deploy, create the account, then set it and redeploy.
ADMIN_USERNAME=your-existing-admin-username
