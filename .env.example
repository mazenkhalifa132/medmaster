# Copy these values to your RunSite app's environment-variable settings.
# Do not commit a real .env file or database password.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-app.runsite.app
CSRF_TRUSTED_ORIGINS=https://your-app.runsite.app
DATABASE_URL=postgresql://database_user:database_password@database_host:5432/database_name
ADMIN_USERNAME=your-existing-admin-username
